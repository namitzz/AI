---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import Quadrant from '../components/Quadrant.astro';
import Gate from '../components/Gate.astro';
import Scorecard from '../components/Scorecard.astro';
import BuiltOn from '../components/BuiltOn.astro';
import Closer from '../components/Closer.astro';
import PrintSheet from '../components/PrintSheet.astro';
---
<Base>
  <div class="site">
    <TopBar />
    <main id="main">
      <Hero />
      <Quadrant />
      <Gate />
      <Scorecard />
      <BuiltOn />
      <Closer />
    </main>
  </div>
  <PrintSheet />
  <noscript><style>.q-panel[hidden], .gate__panel[hidden] { display: block !important; } .quad__progress, .score__actions, .q-next, .gate__panel .btn { display: none !important; }</style></noscript>
  <script>
    import '../scripts/app.ts';
  </script>
</Base>
