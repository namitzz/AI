---
import SectionHead from './SectionHead.astro';
import QArt from './QArt.astro';
import Icon from './Icon.astro';
import type { Art } from '../data/content';

// Short hands-on experiences. The games live in scripts/lab.ts; each dialog
// here is just the shell.
const labs: { id: string; title: string; line: string; q?: string; time: string; art?: Art }[] = [
  { id: 'stamp', title: 'Rubber stamp test', line: '12 AI decisions, 20 seconds. Flag the ones that need a person to step in.', q: '08', time: '20 sec', art: 'stack' },
  { id: 'drill', title: 'The 3am drill', line: 'An AI is misbehaving at 3am. Pick who can actually stop it.', q: '07', time: '30 sec', art: 'clock' },
  { id: 'inject', title: 'Spot the injection', line: 'Three messages. One is trying to hijack your AI. Can you spot it?', q: '03', time: '30 sec', art: 'inject' },
  { id: 'drift', title: 'The drift dial', line: 'Drag time forward and watch an approval approach review, then expire.', q: '05', time: '20 sec', art: 'update' },
];
---
<section class="section" id="lab" aria-labelledby="lab-title">
  <div class="wrap">
    <SectionHead n="03" label="The 60-second lab" id="lab-title">
      <Fragment slot="title">Don’t take my word for it.<br /><span class="accent">Try it.</span></Fragment>
      <p>Four quick experiments, none longer than a minute, and one question to take away. Each puts you in the board’s seat for a single question. All scenarios are fictional and simplified.</p>
    </SectionHead>

    <ul class="lab">
      {labs.map((l) => (
        <li data-reveal>
          <button class="lab__card" type="button" data-open-lab={l.id} aria-haspopup="dialog">
            <span class="lab__meta">
              <span class="label lab__time">{l.time}</span>
              {l.q && <span class="label">Question {l.q}</span>}
            </span>
            {l.art && <QArt art={l.art} />}
            <span class="lab__title">{l.title}</span>
            <span class="lab__line">{l.line}</span>
            <span class="lab__go">Start <Icon name="arrow" /></span>
          </button>
        </li>
      ))}
      <li class="lab__wide" data-reveal>
        <div class="lab__card lab__card--reflect lab__text">
          <span class="lab__meta"><span class="label lab__time">To take away</span></span>
          <h3 class="lab__title" id="lab-reflect-title">Before you sign it off</h3>
          <p class="lab__line">Think of an AI system you use or work with. What would make you stop trusting it? Who would be responsible if it failed? And what evidence would you need before allowing it to continue?</p>
          <p class="lab__takeaway">If you can’t explain why it’s safe to continue, are you ready to sign it off?</p>
        </div>
      </li>
    </ul>
  </div>

  {labs.map((l) => (
    <dialog class="lab-dlg" id={`lab-${l.id}`} aria-labelledby={`lab-${l.id}-title`} data-lab={l.id}>
      <div class="lab-dlg__bar">
        <p class="lab-dlg__title" id={`lab-${l.id}-title`}>{l.title}</p>
        <button class="iconbtn lab-dlg__close" type="button" data-close-lab>
          <span class="visually-hidden">Close</span>
          <Icon name="close" />
        </button>
      </div>
      <div class="lab-dlg__body" data-lab-body></div>
    </dialog>
  ))}
</section>
