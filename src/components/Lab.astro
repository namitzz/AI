---
import SectionHead from './SectionHead.astro';
import QArt from './QArt.astro';
import Icon from './Icon.astro';
import type { Art } from '../data/content';

// Short hands-on experiences. The games themselves live in scripts/lab.ts and
// load on first open; each dialog here is just the shell.
const labs: { id: string; title: string; line: string; q?: string; time: string; art?: Art }[] = [
  { id: 'stamp', title: 'Rubber stamp test', line: 'Review 12 AI decisions in 20 seconds. Can you still spot the bad one?', q: '08', time: '20 sec', art: 'stack' },
  { id: 'drill', title: 'The 3am drill', line: 'An AI is running wild. Pick who can actually switch it off.', q: '07', time: '30 sec', art: 'clock' },
  { id: 'inject', title: 'Spot the injection', line: 'One of three emails is trying to hijack your AI. Which one?', q: '03', time: '30 sec', art: 'inject' },
  { id: 'drift', title: 'The drift dial', line: 'Drag time forward and watch an approval quietly expire.', q: '05', time: '20 sec', art: 'update' },
];
---
<section class="section" id="lab" aria-labelledby="lab-title">
  <div class="wrap">
    <SectionHead n="03" label="The 60-second lab" id="lab-title">
      <Fragment slot="title">Don’t take my word for it.<br /><span class="accent">Try it.</span></Fragment>
      <p>Five quick experiments, none longer than a minute. Each one puts you in the board’s seat for a single question.</p>
    </SectionHead>

    <ul class="lab">
      {labs.map((l) => (
        <li data-reveal>
          <button class="lab__card" type="button" data-open-lab={l.id} aria-haspopup="dialog">
            <span class="lab__meta">
              <span class="label lab__time">{l.time}</span>
              {l.q && <span class="label">Question {l.q}</span>}
            </span>
            {l.art && <QArt art={l.art} />}
            <span class="lab__title">{l.title}</span>
            <span class="lab__line">{l.line}</span>
            <span class="lab__go">Start <Icon name="arrow" /></span>
          </button>
        </li>
      ))}
      <li class="lab__wide" data-reveal>
        <button class="lab__card lab__card--licence" type="button" data-open-lab="licence" aria-haspopup="dialog">
          <span class="lab__meta"><span class="label lab__time">60 sec</span><span class="label">Take it with you</span></span>
          <span class="lab__cert" aria-hidden="true">
            <span class="label">AI system licence</span>
            <span class="lab__cert-name">Your AI here</span>
            <span class="lab__cert-stamp">Licensed</span>
          </span>
          <span class="lab__title">Issue your AI licence</span>
          <span class="lab__line">Name a system you are responsible for, set the conditions that end its licence, and save the certificate as an image. Nothing leaves your phone.</span>
          <span class="lab__go">Make mine <Icon name="arrow" /></span>
        </button>
      </li>
    </ul>
  </div>

  {[...labs.map((l) => ({ id: l.id, title: l.title })), { id: 'licence', title: 'Issue your AI licence' }].map((l) => (
    <dialog class="lab-dlg" id={`lab-${l.id}`} aria-labelledby={`lab-${l.id}-title`} data-lab={l.id}>
      <div class="lab-dlg__bar">
        <p class="lab-dlg__title" id={`lab-${l.id}-title`}>{l.title}</p>
        <button class="iconbtn lab-dlg__close" type="button" data-close-lab>
          <span class="visually-hidden">Close</span>
          <Icon name="close" />
        </button>
      </div>
      <div class="lab-dlg__body" data-lab-body></div>
    </dialog>
  ))}
</section>
