---
import ShieldMark from './ShieldMark.astro';
import Icon from './Icon.astro';
import { event } from '../data/content';

const route = [
  { href: '#questions', n: '01', label: 'Read the 8 questions' },
  { href: '#gate', n: '02', label: 'Walk the investment gate' },
  { href: '#scorecard', n: '03', label: 'Score your board' },
];
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__grid wrap">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">
        <span class="tag">{event.dateShort}</span>
        <span>IET London</span>
      </p>
      <h1 id="hero-title" class="hero__title display">
        <span class="line">Before you</span>
        <span class="line hero__accent"><span class="hero__mark">Sign off</span></span>
        <span class="line">on AI</span>
      </h1>
      <p class="hero__sub">Eight questions every board should ask before approving AI investment.</p>
    </div>

    <div class="hero__art" data-tilt>
      <ShieldMark variant="hero" />
    </div>

    <div class="hero__route">
      <p class="label" id="route-label">Your 2 minute route</p>
      <ol class="route" aria-labelledby="route-label">
        {route.map((r, i) => (
          <li>
            <a class:list={['route__link', i === 0 && 'route__link--primary']} href={r.href}>
              <span class="route__n">{r.n}</span>
              <span class="route__label">{r.label}</span>
              <Icon name="arrow" />
            </a>
          </li>
        ))}
      </ol>
      <p class="hero__event">
        <span class="label">At</span>
        {event.name}. {event.hosts}, {event.venue}, {event.date}.
      </p>
    </div>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[0, 1].map(() => (
      <span class="ticker__set">
        {['AI governance', 'Regulation', 'Assurance', 'AI and cyber risk', 'Security as a business enabler'].map((t) => (
          <>
            <span>{t}</span>
            <svg viewBox="0 0 32 32"><path d="M16 2.5 L27 6.5 V15.5 C27 22 22.5 26.8 16 29.5 C9.5 26.8 5 22 5 15.5 V6.5 Z" /></svg>
          </>
        ))}
      </span>
    ))}
  </div>
</div>
