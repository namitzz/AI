---
import ShieldMark from './ShieldMark.astro';
import Icon from './Icon.astro';
import { event, site, author } from '../data/content';
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__grid wrap">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">
        <span class="tag">{event.dateShort}</span>
        <span>IET London</span>
      </p>
      <h1 id="hero-title" class="hero__title display">
        <span class="line">Before you</span>
        <span class="line hero__accent"><span class="hero__mark">Sign off</span></span>
        <span class="line">on AI</span>
      </h1>
      <p class="hero__hook">{site.hook}</p>
      <p class="hero__sub">{site.support}</p>
      <div class="hero__ctas">
        <a class="score-cta" href="#scorecard">
          <span class="score-cta__label">Score yours</span>
          <span class="score-cta__meta"><span data-bar-score>0/5</span> · 30 seconds</span>
          <Icon name="arrow-down" class="score-cta__icon" />
        </a>
        <a class="btn btn--ghost hero__second" href="#questions">
          Read the 8 questions
          <Icon name="arrow" />
        </a>
      </div>
    </div>

    <figure class="hero__art" data-hero-art>
      <ShieldMark variant="hero" />
      <canvas class="hero__canvas" aria-hidden="true" data-shield3d></canvas>
      <figcaption class="hero__status" aria-hidden="true">
        <span class="hero__status-dot"></span>
        <span data-status-text>Status: approved, v1.0</span>
      </figcaption>
      <p class="hero__drag label" aria-hidden="true">Drag to turn it</p>
    </figure>

    <p class="hero__event">
      A companion to {author.name}’s poster, <span data-event-tense>being presented</span> at {event.name} ({event.hosts}), {event.venue}, on {event.date}. {site.licenceNote}
    </p>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[0, 1].map(() => (
      <span class="ticker__set">
        {['Sign-off is a licence', 'not a verdict', 'No evidence', 'No sign-off', 'Material change: reassess'].map((t) => (
          <>
            <span>{t}</span>
            <svg viewBox="0 0 32 32"><path d="M16 2.5 L27 6.5 V15.5 C27 22 22.5 26.8 16 29.5 C9.5 26.8 5 22 5 15.5 V6.5 Z" /></svg>
          </>
        ))}
      </span>
    ))}
  </div>
</div>
