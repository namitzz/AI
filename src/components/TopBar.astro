---
import Icon from './Icon.astro';

const links = [
  { href: '#questions', label: 'Questions', n: '01' },
  { href: '#gate', label: 'Gate', n: '02' },
  { href: '#scorecard', label: 'Scorecard', n: '03' },
  { href: '#built-on', label: 'Built on', n: '04' },
  { href: '#connect', label: 'Connect', n: '05' },
];
---
<a class="skip" href="#main">Skip to content</a>
<header class="topbar" data-topbar>
  <div class="topbar__inner wrap">
    <a class="brand" href="#top" aria-label="Before you sign off on AI, back to top">
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 2.5 L27 6.5 V15.5 C27 22 22.5 26.8 16 29.5 C9.5 26.8 5 22 5 15.5 V6.5 Z" />
        <path class="brand__check" d="M11 16 L14.5 19.5 L21 12.5" />
      </svg>
      <span class="brand__word">Sign <span class="accent">off</span></span>
    </a>

    <nav class="topnav" aria-label="Sections">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} data-navlink>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="topbar__actions">
      <a class="btn btn--accent btn--sm topbar__cta" href="#scorecard">Score <span data-bar-score>0/5</span></a>
      <button class="iconbtn topbar__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
  <div class="topbar__progress" aria-hidden="true"><span data-progress></span></div>

  <nav id="menu" class="menu" aria-label="Sections" hidden data-menu>
    <ol class="wrap">
      {links.map((l) => (
        <li>
          <a href={l.href} data-menu-link>
            <span class="menu__n">{l.n}</span>
            <span class="menu__label">{l.label}</span>
            <Icon name="arrow" />
          </a>
        </li>
      ))}
    </ol>
  </nav>
</header>
