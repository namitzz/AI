---
import Icon from './Icon.astro';
import { author, event } from '../data/content';
---
<section class="closer" id="connect" aria-labelledby="closer-title">
  <div class="wrap">
    <p class="eyebrow"><span class="tag">07</span><span>The rule</span></p>
    <h2 class="display closer__title" id="closer-title" data-closer>
      <span class="line" style="--l:0">No evidence.</span>
      <span class="line accent" style="--l:1">No sign-off.</span>
    </h2>

    <p class="closer__quote" data-closer>
      Security and assurance aren’t the <span class="brake">brake<svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M0 5 H100" pathLength="1" /></svg></span>. They’re the <span class="accel">accelerator.</span>
    </p>
  </div>

  <div class="closer__panel">
    <div class="wrap closer__cta">
      <a class="li-btn" href={author.linkedin} target="_blank" rel="noopener me">
        <Icon name="linkedin" />
        <span class="li-btn__text">
          <span class="li-btn__top">Talk to Namit about AI assurance</span>
          <span class="li-btn__main">Connect on LinkedIn</span>
        </span>
        <Icon name="arrow" class="li-btn__arrow" />
      </a>

      <p class="credit">
        <span class="credit__name">{author.name}</span>
        <span class="credit__course">{author.course} · IET London, {event.date}</span>
      </p>

      <div class="closer__more">
        <button class="btn btn--onaccent" type="button" data-print>
          <Icon name="print" />
          Download the board checklist
        </button>
        <button class="btn btn--onaccent" type="button" data-share-page>
          <Icon name="share" />
          Share this page
        </button>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer__inner">
    <p>Made for {event.name}, {event.hosts}, {event.venue}, {event.date}.</p>
    <p>A practical framework, not a compliance guarantee. No cookies; visits are counted anonymously. Your scorecard stays on your device.</p>
  </div>
</footer>
