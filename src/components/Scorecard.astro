---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { BASE_PATH } from '../../site.config.mjs';
import { scoreItems, verdicts, blockedVerdict, allQuestions, scoreInstruction } from '../data/content';

// Shipped to the browser so the script can build verdicts and suggestions.
const data = {
  verdicts,
  blocked: blockedVerdict,
  items: scoreItems.map(({ id, label, startWith }) => ({ id, label, startWith })),
  questions: Object.fromEntries(allQuestions.map((q) => [q.n, { q: q.q, pillar: q.pillar }])),
};
---
<section class="section section--surface" id="scorecard" aria-labelledby="score-title">
  <div class="wrap">
    <SectionHead n="06" label="Board scorecard" id="score-title">
      <Fragment slot="title">Score yours.<br /><span class="accent">Evidence only.</span></Fragment>
      <p>Five controls. Tick one only if you could show the evidence tomorrow. Your answers stay on this device.</p>
    </SectionHead>

    <div class="shared-banner" hidden data-shared-banner role="status">
      <p><span class="label">Shared score</span> <span data-shared-text></span></p>
    </div>

    <div class="score" data-score data-reveal>
      <ol class="score__rules">
        {scoreInstruction.map((r, i) => (
          <li><span class="score__rule-n">{i + 1}</span><span>{r}</span></li>
        ))}
      </ol>

      <div class="score__top">
        <div class="score__num" aria-hidden="true">
          <span class="score__val" data-score-val>0</span><span class="score__of">/5</span>
        </div>
        <div class="score__meter" aria-hidden="true">
          {scoreItems.map((_, i) => <span class="score__seg" style={`--i:${i}`}></span>)}
        </div>
        <div class="score__verdict" aria-live="polite" aria-atomic="true">
          <p class="visually-hidden" data-score-sr>Score 0 out of 5.</p>
          <p class="score__title" data-verdict-title>{verdicts[0].title}</p>
          <p class="score__line" data-verdict-line>{verdicts[0].line}</p>
        </div>
        <div class="stamp stamp--ok" aria-hidden="true">
          <span>Licensed</span>
          <small>Until it changes</small>
        </div>
        <div class="stamp stamp--block" aria-hidden="true">
          <span>Blocked</span>
          <small>Critical gap</small>
        </div>
      </div>

      <fieldset class="score__list">
        <legend class="score__legend">Is there evidence each control is operating?</legend>
        {scoreItems.map((item) => (
          <div class="check-row" data-row={item.id}>
            <label class="check">
              <input type="checkbox" name={item.id} value="1" data-score-item={item.id} />
              <span class="check__box" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 12.5 L10 17.5 L19 7" pathLength="1" /></svg>
              </span>
              <span class="check__text">
                <span class="check__key label">{item.label}</span>
                <span class="check__desc">{item.text}</span>
              </span>
            </label>
            <button class="crit" type="button" aria-pressed="false" data-critical={item.id}>
              <span class="crit__box" aria-hidden="true"></span>
              <span>Critical<span class="visually-hidden">: {item.label}</span></span>
            </button>
          </div>
        ))}
      </fieldset>
      <p class="score__crit-hint">Mark a control critical if this system’s risk assessment says it must be in place. A critical control without evidence blocks approval.</p>

      <div class="score__next" data-start-with>
        <p class="label" data-start-label>Start with these questions</p>
        <ul class="chips" data-chips></ul>
      </div>

      <div class="score__actions">
        <button class="btn btn--accent" type="button" data-share>
          <Icon name="share" />
          Share my score
        </button>
        <a class="btn btn--ghost" href={`${BASE_PATH}/board-checklist.pdf`} download>
          <Icon name="print" />
          Download the board checklist (PDF)
        </a>
        <button class="btn btn--ghost" type="button" data-print>
          <Icon name="print" />
          Print it with my answers
        </button>
        <button class="btn btn--text" type="button" data-reset>
          <Icon name="reset" />
          Reset
        </button>
      </div>
      <p class="score__status" role="status" aria-live="polite" data-status></p>
      <p class="score__hint">The PDF is a blank one-page checklist. “Print it with my answers” fills in your ticks; choose Save as PDF in the print dialog to keep a copy.</p>
    </div>
  </div>
  <script type="application/json" id="score-data" set:html={JSON.stringify(data)} />
</section>
