---
// The whole page. Rendered at / and at /s/ (the poster QR code target).
import Base from '../layouts/Base.astro';
import TopBar from './TopBar.astro';
import Hero from './Hero.astro';
import Gap from './Gap.astro';
import Quadrant from './Quadrant.astro';
import Lab from './Lab.astro';
import PilotTrap from './PilotTrap.astro';
import Gate from './Gate.astro';
import Scorecard from './Scorecard.astro';
import BuiltOn from './BuiltOn.astro';
import Closer from './Closer.astro';
import PrintSheet from './PrintSheet.astro';
---
<Base>
  <div class="site">
    <TopBar />
    <main id="main">
      <p class="today" hidden data-today>
        <span class="today__dot" aria-hidden="true"></span>
        <span data-today-text>Coming up at IET London, Savoy Place · 4 November 2026.</span>
      </p>
      <Hero />
      <Gap />
      <Quadrant />
      <Lab />
      <PilotTrap />
      <Gate />
      <Scorecard />
      <BuiltOn />
      <Closer />
    </main>
  </div>
  <p class="toast" role="status" aria-live="polite" data-toast></p>
  <PrintSheet />
  <noscript><style>.q-panel[hidden], .gate__panel[hidden] { display: block !important; } .quad__progress, .score__actions, .q-next, .gate__panel .btn, .crit, .score__crit-hint, #lab, .q-card__actions, [data-print] { display: none !important; }</style></noscript>
  <script>
    import '../scripts/app.ts';
  </script>
</Base>
